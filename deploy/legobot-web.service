[Unit]
Description=LegoBot web control
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jerem
Group=jerem
WorkingDirectory=/home/jerem/Legobot
Environment=PYTHONPATH=/home/jerem/Legobot/src
Environment=LEGOBOT_ROBOT_NAME=Briqo
Environment=LEGOBOT_VOICE_MODEL=next
Environment=LEGOBOT_OLLAMA_MODEL=qwen3.5:latest
Environment=LEGOBOT_OLLAMA_URL=http://192.168.1.12:11434
Environment=LEGOBOT_FALLBACK_OLLAMA_MODEL=qwen2.5:1.5b
Environment=LEGOBOT_FALLBACK_OLLAMA_URL=http://127.0.0.1:11434
Environment=LEGOBOT_MIC_DEVICE=plughw:CARD=Device,DEV=0
Environment=LEGOBOT_VOSK_MODEL=models/vosk-model-small-fr-0.22
Environment=LEGOBOT_WAKE_ON_START=1
Environment=LEGOBOT_WAKE_SILENCE_SECONDS=0.75
Environment=LEGOBOT_WAKE_MAX_SECONDS=5.0
Environment=LEGOBOT_MIC_SPEECH_RMS=900
Environment=LEGOBOT_HEAD_DEGREES=28
Environment=LEGOBOT_EYES_DEGREES=14
Environment=LEGOBOT_MOTOR_SPEED=35
ExecStart=/usr/bin/python3 /home/jerem/Legobot/src/web_control.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
